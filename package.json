{
  "name": "udream-mqtt-ui",
  "private": true,
  "version": "0.1.0",
  "description": "MQTT/IoT 设备联调自测 UI（开发者自测用，非生产代码）",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n sim,web -c blue,green \"npm run dev:sim\" \"npm run dev:web\"",
    "dev:sim": "tsx watch sim-server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "@types/spark-md5": "^3.0.5",
    "antd": "^5.21.0",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "express": "^4.21.2",
    "mqtt": "^5.10.4",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "spark-md5": "^3.0.2",
    "uuid": "^11.1.0",
    "ws": "^8.18.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.19.3",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
